# Database (Neon)
DATABASE_URL=postgresql://user:password@host:5432/neondb

# App URL
NEXT_PUBLIC_URL=http://localhost:3000

# Billplz (Payment Gateway)
BILLPLZ_API_URL=https://www.billplz.com/api/v3
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SIGNATURE_KEY=
# Payment Order Collection ID (Billplz V5) — used to disburse payouts to artists/studios
BILLPLZ_PAYMENT_ORDER_COLLECTION_ID=

# Cloudinary (Image Upload)
# Required for both server-stream uploads and signed browser uploads.
# The same CLOUDINARY_API_SECRET value must be set in BOTH this .env
# (for local dev) and Vercel env vars (for production).
# After pasting, run: npx tsx scripts/verify-sign.ts
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WEBHOOK_SECRET=

# Brevo (Transactional Email Outbound)
BREVO_API_KEY=
FROM_EMAIL=hello@leish.my
FROM_NAME=Leish

# Inbound email is handled by Cloudflare Email Routing (MX → Cloudflare)
# https://dash.cloudflare.com → Email → Routing
# Routes forward each @leish.my alias to the appropriate Gmail inboxes
# No Brevo Inbound Parse needed

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# WhatsApp Notifications
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Cron / Webhook
CRON_SECRET=

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_NEON_AUTH_BASE_URL=

# Neon Auth DB (optional — only required by the sync-auth-users cron)
NEON_AUTH_URL=

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Meta Pixel / Facebook Pixel (optional)
NEXT_PUBLIC_FB_PIXEL_ID=

# Meta MCP (Developer Tools + Ads)
# Requires a Meta developer app with OAuth configured.
# See AGENTS.md "Meta MCP" section for setup steps.
# META_APP_ID is the numeric ID of your Meta developer app (client_id).
# META_ADS_TOKEN is a user access token granted the ads MCP scopes
# (ads_mcp_management, ads_read, ads_management, catalog_management,
# business_management, pages_show_list, instagram_basic). Pass it to the
# /ads server via the Authorization: Bearer header (opencode's dynamic OAuth
# registration is rejected by Meta, so a header token is the reliable path).
# Get a token via the Graph API Explorer (developers.facebook.com/tools/explorer).
META_APP_ID=
META_ADS_TOKEN=
NEXT_PUBLIC_MCP_META_DEVTOOLS=
NEXT_PUBLIC_MCP_META_ADS=

# Sentry (Error Monitoring)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Maps Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email Aliases
SUPPORT_EMAIL=support@leish.my
BILLING_EMAIL=billing@leish.my
MARKETING_EMAIL=marketing@leish.my
ADMIN_EMAIL=admin@leish.my
NOTIFICATIONS_EMAIL=notifications@leish.my
INFO_EMAIL=info@leish.my
STUDIO_EMAIL=studio@leish.my
ARTIST_EMAIL=artist@leish.my

# Inbound Email (Cloudflare Email Routing → Gmail)
# Each @leish.my alias forwards directly to a Gmail inbox
# Configured in Cloudflare Dashboard → Email → Routing
CENTRAL_INBOX_EMAIL=leishstudio.main@gmail.com

# VAPID (Web Push Notifications)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@leish.my
